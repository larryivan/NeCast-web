---
// The home-page visual, drawn at build time from a real training window (sim_00000016):
// the genotypes of 32 individuals at 48 variant sites feed five streams, which end in the
// window's 64 interval labels on log axes. No text inside, so it serves both languages; the
// colours come from Starlight's theme, so it follows light and dark mode.
import windowData from '../../data/hero_window.json';

interface Props {
  label: string;
}
const { label } = Astro.props;

const W = 560;
const H = 380;
const rows = windowData.genotypes;
const nRows = rows.length;
const nCols = rows[0].length;
const pitch = 5.4;
const cell = 4.4;
const rasterW = nCols * pitch;
const rasterH = nRows * pitch;
const x0 = 8;
const y0 = (H - rasterH) / 2;

// plot area, the same height as the raster
const px0 = 366;
const px1 = W - 8;
const py0 = y0;
const py1 = y0 + rasterH;
const edges = windowData.edges;
const labels = windowData.labels;
const tLo = Math.log10(edges[0]);
const tHi = Math.log10(edges[edges.length - 1]);
const nLo = Math.floor((Math.min(...labels) - 0.25) * 2) / 2;
const nHi = Math.ceil((Math.max(...labels) + 0.25) * 2) / 2;
const sx = (t: number) => px0 + ((Math.log10(t) - tLo) / (tHi - tLo)) * (px1 - px0);
const sy = (v: number) => py1 - ((v - nLo) / (nHi - nLo)) * (py1 - py0);

const step = labels
  .map((v, b) => `${b === 0 ? 'M' : 'L'}${sx(edges[b]).toFixed(1)},${sy(v).toFixed(1)} L${sx(edges[b + 1]).toFixed(1)},${sy(v).toFixed(1)}`)
  .join(' ');
const area = `${step} L${px1},${py1} L${px0},${py1} Z`;
const decadesNe = [2, 3, 4, 5, 6].filter((d) => d > nLo && d < nHi);
const decadesT = [2, 3, 4, 5];

// five streams from the raster's right edge to a merge point before the plot
const mergeX = 336;
const mergeY = H / 2;
const streams = [0.1, 0.3, 0.5, 0.7, 0.9].map((f) => {
  const ys = y0 + f * rasterH;
  const xs = x0 + rasterW + 6;
  return `M${xs},${ys.toFixed(1)} C${xs + 30},${ys.toFixed(1)} ${mergeX - 30},${mergeY} ${mergeX},${mergeY}`;
});
---

<svg class="hero-visual" viewBox={`0 0 ${W} ${H}`} role="img" aria-label={label}>
  <g class="raster">
    {
      Array.from({ length: nCols }, (_, c) => (
        <g style={`--i:${c}`} class="col">
          {rows.map((row, r) => (
            <rect
              x={(x0 + c * pitch).toFixed(1)}
              y={(y0 + r * pitch).toFixed(1)}
              width={cell}
              height={cell}
              rx="0.8"
              class={row[c] === 'm' ? 'gm' : `g${row[c]}`}
            />
          ))}
        </g>
      ))
    }
  </g>
  <g class="streams">
    {streams.map((d) => <path d={d} pathLength="1" />)}
    <circle cx={mergeX} cy={mergeY} r="3.2" />
    <path d={`M${mergeX + 4},${mergeY} L${px0 - 8},${mergeY}`} pathLength="1" />
  </g>
  <g class="plot">
    {decadesNe.map((d) => <line x1={px0} x2={px1} y1={sy(d)} y2={sy(d)} class="grid" />)}
    {decadesT.map((d) => <line x1={sx(10 ** d)} x2={sx(10 ** d)} y1={py0} y2={py1} class="grid" />)}
    <line x1={px0} x2={px0} y1={py0} y2={py1} class="axis" />
    <line x1={px0} x2={px1} y1={py1} y2={py1} class="axis" />
    <path d={area} class="area" />
    <path d={step} class="curve" pathLength="1" />
  </g>
</svg>

<style>
  .hero-visual {
    width: 100%;
    height: auto;
    overflow: visible;
    color: var(--sl-color-gray-3);
  }
  .g0 {
    fill: var(--sl-color-gray-6);
  }
  .g1 {
    fill: color-mix(in srgb, var(--sl-color-accent) 48%, var(--sl-color-bg));
  }
  .g2 {
    fill: var(--sl-color-accent);
  }
  .gm {
    fill: #e0a33b;
  }
  .streams path {
    fill: none;
    stroke: var(--sl-color-accent);
    stroke-width: 1.4;
    opacity: 0.55;
  }
  .streams circle {
    fill: var(--sl-color-accent);
  }
  .grid {
    stroke: currentColor;
    stroke-width: 0.6;
    opacity: 0.35;
    stroke-dasharray: 2 3;
  }
  .axis {
    stroke: currentColor;
    stroke-width: 0.8;
  }
  .area {
    fill: var(--sl-color-accent);
    opacity: 0.1;
  }
  .curve {
    fill: none;
    stroke: var(--sl-color-accent);
    stroke-width: 2.4;
    stroke-linejoin: round;
  }

  @media (prefers-reduced-motion: no-preference) {
    .col {
      animation: cell-in 0.5s ease-out both;
      animation-delay: calc(var(--i) * 16ms);
    }
    .streams path {
      stroke-dasharray: 1;
      stroke-dashoffset: 1;
      animation: draw 0.7s ease-out 0.75s forwards;
    }
    .streams circle,
    .area {
      animation: fade-in 0.6s ease-out 1.3s both;
    }
    .curve {
      stroke-dasharray: 1;
      stroke-dashoffset: 1;
      animation: draw 1.3s ease-in-out 1.2s forwards;
    }
  }
  @keyframes cell-in {
    from {
      opacity: 0;
      transform: translateY(3px);
    }
  }
  @keyframes draw {
    to {
      stroke-dashoffset: 0;
    }
  }
  @keyframes fade-in {
    from {
      opacity: 0;
    }
  }
</style>
