---
// Numbered steps whose order is real: from a window to its size history on the home page, and
// from filtering to downloading on the explorer page (compact). Step text may hold links.
interface Props {
  steps: { title: string; text: string }[];
  more?: { text: string; link: string };
  compact?: boolean;
}
const { steps, more, compact = false } = Astro.props;
---

<div class:list={['flow not-content', { compact }]}>
  <ol>
    {
      steps.map((step, i) => (
        <li>
          <span class="n">{i + 1}</span>
          <h3>{step.title}</h3>
          <p set:html={step.text} />
        </li>
      ))
    }
  </ol>
  {
    more && (
      <a class="more" href={more.link}>
        {more.text} <span aria-hidden="true">→</span>
      </a>
    )
  }
</div>

<style>
  .flow ol {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));
    gap: 1rem;
    counter-reset: step;
  }
  .flow li {
    position: relative;
    padding: 1.25rem 1.25rem 1.35rem;
    border-radius: 0.75rem;
    background: color-mix(in srgb, var(--sl-color-accent) 7%, var(--sl-color-bg));
  }
  .n {
    display: inline-grid;
    place-items: center;
    width: 1.75rem;
    height: 1.75rem;
    border-radius: 999px;
    font-size: var(--sl-text-sm);
    font-weight: 700;
    color: var(--sl-color-text-invert);
    background: var(--sl-color-accent);
  }
  h3 {
    margin: 0.85rem 0 0.4rem;
    font-size: var(--sl-text-lg);
    color: var(--sl-color-white);
  }
  p {
    margin: 0;
    font-size: var(--sl-text-sm);
    line-height: 1.6;
    color: var(--sl-color-gray-2);
  }
  @media (min-width: 50rem) {
    .flow li:not(:last-child)::after {
      content: '';
      position: absolute;
      top: 2.1rem;
      right: -0.85rem;
      width: 0.7rem;
      height: 0.7rem;
      border-top: 2px solid var(--sl-color-accent);
      border-right: 2px solid var(--sl-color-accent);
      transform: rotate(45deg);
      opacity: 0.6;
    }
  }
  .more {
    display: inline-block;
    margin-top: 1rem;
    font-weight: 600;
    text-decoration: none;
    color: var(--sl-color-text-accent);
  }
  .more:hover {
    text-decoration: underline;
  }
  p :global(a) {
    color: var(--sl-color-text-accent);
  }
  /* compact: the number beside the title, less padding */
  .compact li {
    display: grid;
    grid-template-columns: auto 1fr;
    column-gap: 0.75rem;
    padding: 0.85rem 1rem 0.95rem;
  }
  .compact .n {
    grid-row: span 2;
    width: 1.5rem;
    height: 1.5rem;
    font-size: var(--sl-text-xs);
  }
  .compact h3 {
    margin: 0.05rem 0 0.25rem;
    font-size: var(--sl-text-base);
  }
  @media (min-width: 50rem) {
    .compact li:not(:last-child)::after {
      top: 1.2rem;
      width: 0.6rem;
      height: 0.6rem;
    }
  }
</style>
