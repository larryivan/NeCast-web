---
// A strip of the numbers that define NeCast's input and output.
interface Props {
  items: { value: string; label: string }[];
}
const { items } = Astro.props;
---

<div class="facts not-content">
  {
    items.map((item) => (
      <div class="fact">
        <span class="value">{item.value}</span>
        <span class="label">{item.label}</span>
      </div>
    ))
  }
</div>

<style>
  /* two by two on phones and tablets, one row from 50rem; the 1px gaps draw the dividers */
  .facts {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1px;
    background: var(--sl-color-hairline-light);
    border-block: 1px solid var(--sl-color-hairline-light);
    margin-block: 0.5rem 2.5rem;
  }
  .fact {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    padding: 1rem 0.9rem;
    background: var(--sl-color-bg);
  }
  .value {
    font-size: clamp(1.5rem, 1.2rem + 1.4vw, 2.2rem);
    font-weight: 650;
    letter-spacing: -0.02em;
    line-height: 1.1;
    font-variant-numeric: tabular-nums;
    color: var(--sl-color-white);
  }
  .label {
    font-size: var(--sl-text-sm);
    line-height: 1.45;
    color: var(--sl-color-gray-3);
  }
  @media (min-width: 50rem) {
    .facts {
      grid-template-columns: repeat(4, 1fr);
    }
    .fact {
      padding: 1.1rem 1.25rem;
    }
  }
</style>
