---
// How a window becomes a size history: the input feeds five streams over the same sites, the
// network combines them into a correction on each interval, and the correction is added to a
// baseline from the window's Watterson estimate. Drawn as inline SVG in theme colours.
import windowData from '../../data/hero_window.json';

interface Props {
  lang?: 'en' | 'zh';
}
const { lang = 'en' } = Astro.props;
const T = {
  en: {
    aria: 'Diagram: the genotypes and maps of one window feed five streams; the network combines them into a correction on each of 64 intervals, which is added to a baseline from the Watterson estimate to give log10 Ne.',
    input: 'One window',
    inputLines: ['32 unphased genomes', '30 Mb of sequence', 'recombination map', 'mutation map'],
    streams: [
      ['Site encoder', 'every site, placed on both maps'],
      ['Site-frequency spectrum', 'folded, over the 32 genomes'],
      ['Linkage disequilibrium', '1 to 64 sites apart, by map distance'],
      ['Identity-by-state tracts', 'length spectra of 496 pairs'],
      ['PSMC+ posterior', 'per genome with both maps, pooled'],
    ],
    network: 'Network',
    networkSub: ['a correction', 'per interval'],
    baseline: 'Baseline',
    baselineSub: ['Watterson level', '+ a fixed offset'],
    output: 'log₁₀ Nₑ',
    outputSub: ['64 intervals', '50 to 500,000', 'generations ago'],
    caption:
      'Every stream reads the same variant sites. The maps are used in two ways: the site encoder and linkage disequilibrium measure distances along them, and PSMC+ decodes each genome with them.',
  },
  zh: {
    aria: '示意图：一个窗口的基因型和图谱进入五路输入；网络把它们合成为 64 个区间上的校正量，加到由 Watterson 估计得到的基线上，得到 log10 Ne。',
    input: '一个窗口',
    inputLines: ['32 个未定相基因组', '30 Mb 序列', '重组图谱', '突变图谱'],
    streams: [
      ['位点编码器', '每个位点，按两张图谱定位'],
      ['位点频率谱', '折叠，32 个基因组'],
      ['连锁不平衡', '相隔 1 到 64 个位点，按图谱距离'],
      ['状态同一片段', '496 对个体的长度谱'],
      ['PSMC+ 后验', '每个基因组用两张图谱解码后汇总'],
    ],
    network: '网络',
    networkSub: ['每个区间的', '校正量'],
    baseline: '基线',
    baselineSub: ['Watterson 水平', '+ 固定偏移'],
    output: 'log₁₀ Nₑ',
    outputSub: ['64 个区间', '距今 50 到', '500,000 代'],
    caption: '五路输入读取的是同一批变异位点。图谱有两种用法：位点编码器和连锁不平衡沿图谱度量距离，PSMC+ 用它们解码每个基因组。',
  },
}[lang];

const W = 800;
const H = 330;
const box = { x: 8, y: 80, w: 170, h: 170 };
const sx = 246;
const sw = 214;
const sh = 42;
const sgap = 10;
const s0 = (H - (5 * sh + 4 * sgap)) / 2;
const net = { x: 528, y: 112, w: 108, h: 80 };
const base = { x: 528, y: 222, w: 108, h: 70 };
const out = { x: 692, y: 120, w: 102, h: 116 };
const midIn = box.y + box.h / 2;
const netMid = net.y + net.h / 2;
const curve = (x1: number, y1: number, x2: number, y2: number) => {
  const dx = (x2 - x1) * 0.5;
  return `M${x1},${y1} C${x1 + dx},${y1} ${x2 - dx},${y2} ${x2},${y2}`;
};
// a small genotype glyph from the same real window as the home page
const glyph = windowData.genotypes.slice(0, 6).map((row) => row.slice(10, 25));
---

<figure class="architecture not-content">
  <div class="scroll">
    <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label={T.aria}>
      <defs>
        <marker id="arch-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
          <path d="M0,0 L10,5 L0,10 z" class="arrowhead" />
        </marker>
      </defs>

      <!-- input -->
      <rect x={box.x} y={box.y} width={box.w} height={box.h} rx="12" class="panel" />
      <text x={box.x + 16} y={box.y + 28} class="title">{T.input}</text>
      {
        glyph.map((row, r) =>
          [...row].map((g, c) => (
            <rect x={box.x + 16 + c * 9.2} y={box.y + 42 + r * 9.2} width="7.6" height="7.6" rx="1.4" class={g === 'm' ? 'gm' : `g${g}`} />
          )),
        )
      }
      {T.inputLines.map((line, i) => (
        <text x={box.x + 16} y={box.y + 116 + i * 17} class={i < 2 ? 'sub strong' : 'sub'}>
          {line}
        </text>
      ))}

      <!-- streams: titles only; the list below the figure describes each -->
      {
        T.streams.map(([title], i) => {
          const y = s0 + i * (sh + sgap);
          const yc = y + sh / 2;
          return (
            <g>
              <path d={curve(box.x + box.w, midIn, sx - 4, yc)} class="link" marker-end="url(#arch-arrow)" />
              <rect x={sx} y={y} width={sw} height={sh} rx="10" class="stream" />
              <text x={sx + 16} y={yc + 5} class="title small">{title}</text>
              <path d={curve(sx + sw, yc, net.x - 4, netMid)} class="link" marker-end="url(#arch-arrow)" />
            </g>
          );
        })
      }

      <!-- network and baseline -->
      <rect x={net.x} y={net.y} width={net.w} height={net.h} rx="12" class="network" />
      <text x={net.x + net.w / 2} y={net.y + 30} class="title invert" text-anchor="middle">{T.network}</text>
      {T.networkSub.map((line, i) => (
        <text x={net.x + net.w / 2} y={net.y + 50 + i * 15} class="sub tiny invert" text-anchor="middle">
          {line}
        </text>
      ))}
      <rect x={base.x} y={base.y} width={base.w} height={base.h} rx="10" class="panel" />
      <text x={base.x + base.w / 2} y={base.y + 24} class="title small" text-anchor="middle">{T.baseline}</text>
      {T.baselineSub.map((line, i) => (
        <text x={base.x + base.w / 2} y={base.y + 42 + i * 15} class="sub tiny" text-anchor="middle">
          {line}
        </text>
      ))}

      <!-- sum and output -->
      <path d={`M${net.x + net.w},${netMid} L${out.x - 4},${out.y + 40}`} class="link strong" marker-end="url(#arch-arrow)" />
      <path d={`M${base.x + base.w},${base.y + base.h / 2} L${out.x - 4},${out.y + out.h - 28}`} class="link strong" marker-end="url(#arch-arrow)" />
      <text x={base.x + base.w + 26} y={base.y + base.h / 2 - 6} class="plus" text-anchor="middle">+</text>
      <rect x={out.x} y={out.y} width={out.w} height={out.h} rx="12" class="output" />
      <text x={out.x + out.w / 2} y={out.y + 38} class="big" text-anchor="middle">{T.output}</text>
      {T.outputSub.map((line, i) => (
        <text x={out.x + out.w / 2} y={out.y + 64 + i * 16} class="sub tiny" text-anchor="middle">
          {line}
        </text>
      ))}
    </svg>
  </div>
  <figcaption>{T.caption}</figcaption>
</figure>

<style>
  .architecture {
    margin-block: 1.5rem 2rem;
  }
  .scroll {
    overflow-x: auto;
  }
  svg {
    display: block;
    width: 100%;
    min-width: 36rem;
    height: auto;
    color: var(--sl-color-gray-2);
    font-family: var(--__sl-font);
  }
  .panel {
    fill: color-mix(in srgb, var(--sl-color-gray-6) 70%, var(--sl-color-bg));
    stroke: var(--sl-color-hairline-light);
  }
  .stream {
    fill: color-mix(in srgb, var(--sl-color-accent) 9%, var(--sl-color-bg));
    stroke: color-mix(in srgb, var(--sl-color-accent) 35%, var(--sl-color-bg));
  }
  .network {
    fill: var(--sl-color-accent);
  }
  .output {
    fill: color-mix(in srgb, var(--sl-color-accent) 14%, var(--sl-color-bg));
    stroke: var(--sl-color-accent);
    stroke-width: 1.5;
  }
  .title {
    font-size: 16px;
    font-weight: 650;
    fill: var(--sl-color-white);
  }
  .title.small {
    font-size: 15px;
  }
  .sub {
    font-size: 13px;
    fill: var(--sl-color-gray-3);
  }
  .sub.tiny {
    font-size: 12px;
  }
  .sub.strong {
    fill: var(--sl-color-gray-2);
    font-weight: 600;
  }
  .invert {
    fill: var(--sl-color-text-invert);
  }
  .big {
    font-size: 21px;
    font-weight: 700;
    fill: var(--sl-color-white);
  }
  .plus {
    font-size: 18px;
    font-weight: 700;
    fill: var(--sl-color-accent);
  }
  .link {
    fill: none;
    stroke: var(--sl-color-gray-4);
    stroke-width: 1.2;
  }
  .link.strong {
    stroke: var(--sl-color-accent);
    stroke-width: 1.6;
  }
  .arrowhead {
    fill: var(--sl-color-gray-4);
  }
  .g0 {
    fill: var(--sl-color-gray-5);
    opacity: 0.45;
  }
  .g1 {
    fill: color-mix(in srgb, var(--sl-color-accent) 48%, var(--sl-color-bg));
  }
  .g2 {
    fill: var(--sl-color-accent);
  }
  .gm {
    fill: #e0a33b;
  }
  figcaption {
    margin-top: 0.75rem;
    font-size: var(--sl-text-sm);
    line-height: 1.6;
    color: var(--sl-color-gray-3);
  }
</style>
