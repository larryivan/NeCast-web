---
// Starlight's header bar, with the site's one menu below it: Home, then a tab for each section
// of the sidebar configuration (astro.config.mjs). No page has a left sidebar, so this row is
// the menu everywhere; the tab of the current section is marked.
import Default from '@astrojs/starlight/components/Header.astro';

const { lang, sidebar } = Astro.locals.starlightRoute;
// the 404 route keeps the root language, so the address decides there
const zh = lang?.toLowerCase().startsWith('zh') || Astro.url.pathname.includes('/zh-cn/');
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const root = `${base}${zh ? 'zh-cn/' : ''}`;
const path = Astro.url.pathname.startsWith(root) ? Astro.url.pathname.slice(root.length) : null;

type Link = { type: 'link'; href: string; label: string; isCurrent: boolean };
type Group = { type: 'group'; label: string; entries: (Link | Group)[] };
const pagesOf = (e: Link | Group): Link[] => (e.type === 'link' ? [e] : e.entries.flatMap(pagesOf));

const tabs = [
  { label: zh ? '首页' : 'Home', href: root, current: path === '' },
  ...(sidebar as (Link | Group)[])
    .filter((e): e is Group => e.type === 'group')
    .map((g) => {
      const pages = pagesOf(g);
      return { label: g.label, href: pages[0].href, current: pages.some((p) => p.isCurrent) };
    }),
];

// phones show no language menu, so the row links the same page in the other language
const other = `${base}${zh ? '' : 'zh-cn/'}${path !== null && !path.startsWith('404') ? path : ''}`;
---

<div class="necast-header">
  <div class="bar"><Default /></div>
  <nav class="tabs print:hidden" aria-label={zh ? '网站栏目' : 'Site sections'}>
    <ul>
      {
        tabs.map((t) => (
          <li>
            <a href={t.href} aria-current={t.current ? 'page' : undefined}>
              {t.label}
            </a>
          </li>
        ))
      }
    </ul>
    <a class="other-lang" href={other} lang={zh ? 'en' : 'zh-CN'} hreflang={zh ? 'en' : 'zh-CN'}>
      {zh ? 'EN' : '中文'}
    </a>
  </nav>
</div>

<style>
  .necast-header {
    display: flex;
    flex-direction: column;
    height: 100%;
  }
  .bar {
    flex: none;
    height: calc(var(--necast-bar-height) - 2 * var(--sl-nav-pad-y));
  }
  .tabs {
    flex: none;
    display: flex;
    align-items: stretch;
    gap: 1rem;
    height: var(--necast-tabs-height);
    margin: var(--sl-nav-pad-y) calc(-1 * var(--sl-nav-pad-x)) calc(-1 * var(--sl-nav-pad-y));
    padding-inline: var(--sl-nav-pad-x);
    border-top: 1px solid var(--sl-color-hairline);
    overflow-x: auto;
    scrollbar-width: none;
  }
  .tabs::-webkit-scrollbar {
    display: none;
  }
  ul {
    display: flex;
    gap: 1rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  li {
    display: flex;
  }
  .tabs a {
    display: flex;
    align-items: center;
    border-bottom: 2px solid transparent;
    font-size: var(--sl-text-sm);
    font-weight: 500;
    white-space: nowrap;
    color: var(--sl-color-gray-2);
    text-decoration: none;
  }
  .tabs a:hover {
    color: var(--sl-color-white);
  }
  .tabs a[aria-current='page'] {
    border-bottom-color: var(--sl-color-accent);
    font-weight: 600;
    color: var(--sl-color-text-accent);
  }
  .other-lang {
    margin-inline-start: auto;
  }
  /* from 50rem the header bar has its own language menu, and the tabs get more room */
  @media (min-width: 50rem) {
    ul {
      gap: 1.6rem;
    }
    .other-lang {
      display: none !important;
    }
  }
</style>
