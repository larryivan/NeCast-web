---
// Starlight's footer (pagination on the documentation pages), followed by the site's own
// line: the name, the licences, and where the project lives.
import Default from '@astrojs/starlight/components/Footer.astro';

const lang = Astro.locals.starlightRoute.lang;
const zh = lang?.toLowerCase().startsWith('zh');
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const home = `${base}${zh ? 'zh-cn/' : ''}`;
const licence = zh ? '数据和权重以 CC BY 4.0 发布，代码以 MIT 发布。' : 'Data and weights under CC BY 4.0, code under MIT.';
---

<Default />
<div class="site-footer">
  <a class="brand" href={home}>
    <img src={`${base}favicon.svg`} alt="" width="20" height="20" />
    NeCast
  </a>
  <p>{licence}</p>
  <nav aria-label={zh ? '项目链接' : 'Project links'}>
    <a href="https://huggingface.co/Larrivhan">Hugging Face</a>
    <a href="https://github.com/larryivan/NeCast">GitHub</a>
  </nav>
</div>

<style>
  .site-footer {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 1.5rem;
    margin-top: 3rem;
    padding-block: 1.25rem 0.5rem;
    border-top: 1px solid var(--sl-color-hairline-light);
    font-size: var(--sl-text-xs);
    color: var(--sl-color-gray-3);
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-size: var(--sl-text-sm);
    font-weight: 600;
    color: var(--sl-color-white);
    text-decoration: none;
  }
  .brand img {
    border-radius: 0.3rem;
  }
  p {
    margin: 0;
  }
  nav {
    display: flex;
    gap: 1.1rem;
    margin-inline-start: auto;
  }
  nav a {
    color: var(--sl-color-gray-3);
    text-decoration: none;
  }
  nav a:hover {
    color: var(--sl-color-text-accent);
  }
</style>
